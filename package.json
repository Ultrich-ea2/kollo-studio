{
  "name": "kollo-studio",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/sync-skill-examples.ts && tsc --noEmit && vite build && tsx scripts/build-examples.ts && node scripts/package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:skill": "python -B -m unittest discover -s tests -p \"test_skill_*.py\""
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "lucide-react": "1.17.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.3",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "6.4.6"
  },
  "overrides": {
    "image-size": "2.1.0"
  }
}
